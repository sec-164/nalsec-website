---
import "../styles/global.css";
import Logo from "../components/Logo.astro";
import SectionNav from "../components/SectionNav.astro";
import TechBanner from "../components/TechBanner.astro";
import { site } from "../data/site";
import { getScreens, navHref } from "../lib/screens";

interface Props {
  title: string;
  /** トップページだけ true。右端にセクションナビを出し、ヒーロー表示中はヘッダーを透明にする(SectionNav の script が切り替える)。 */
  home?: boolean;
}

const { title, home = false } = Astro.props;
// 画面一覧は src/lib/screens.ts が唯一の定義。ナビのリンク先は各項目に属する最初の画面。
const screens = await getScreens();
const nav = site.nav.map((item) => ({
  ...item,
  href: navHref(screens, item.id),
}));
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=M+PLUS+1p:wght@400;700&family=Montserrat:wght@400;700&display=swap"
    />
    <slot name="head" />
  </head>
  <body class="bg-background font-sans text-foreground antialiased">
    <!-- data-scrolled はトップページのヒーロー表示中だけ JS が "false" にする(透明・ロゴ非表示)。JS なしでは常に黒。 -->
    <header
      data-site-header
      data-scrolled="true"
      class="peer/header group/header fixed inset-x-0 top-0 z-50 border-b border-line bg-black/60 backdrop-blur transition-[background-color,backdrop-filter,border-color] duration-300 motion-reduce:transition-none data-[scrolled=false]:border-transparent data-[scrolled=false]:bg-transparent data-[scrolled=false]:backdrop-blur-none"
    >
      <div class="container-x flex h-14 items-center gap-6">
        <a
          href="/"
          aria-label={`${site.name} トップへ`}
          class="flex items-center transition-[opacity,visibility] duration-300 group-data-[scrolled=false]/header:invisible group-data-[scrolled=false]/header:opacity-0 motion-reduce:transition-none"
        >
          <Logo class="h-5" decorative />
        </a>
        <nav aria-label="サイト内" class="ml-auto">
          <ul class="flex items-baseline gap-x-5 text-xs font-bold tracking-[0.15em] whitespace-nowrap md:gap-x-8">
            {nav.map((item) => (
              <li>
                <a href={item.href} class="transition-colors hover:text-muted">
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    {/* TechBanner と SectionNav はヘッダーより後ろの兄弟に置くこと(どちらもヘッダーの data-scrolled を peer/header で読む) */}
    <TechBanner />
    <main>
      <slot />
    </main>
    {/* main の後ろに置く: SectionNav の script は main 内の目印(各画面の id)をその場で引く */}
    {home && <SectionNav />}
    <footer class="relative z-20 border-t border-line bg-background">
      <div class="container-x flex items-center justify-between gap-4 py-8 text-sm text-muted">
        <Logo class="h-4 text-foreground" decorative />
        <p>© NALSEC</p>
      </div>
    </footer>
  </body>
</html>
