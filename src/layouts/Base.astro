---
import { site } from "../data/site";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    <header>
      <a href="/">株式会社NALSEC</a>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>
        {site.address.postalCode} {site.address.text}
      </p>
      <p>電話: {site.phone}</p>
      <ul>
        {site.businessLines.map((line) => (
          <li>{line}</li>
        ))}
      </ul>
    </footer>
  </body>
</html>
