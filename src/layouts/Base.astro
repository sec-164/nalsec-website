---
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
const nav = [
  { href: "/#products", label: "製品" },
  { href: "/#services", label: "サービス" },
  { href: "/#company", label: "会社情報" },
];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=M+PLUS+1p:wght@400;700&family=Montserrat:wght@400;700&display=swap"
    />
    <slot name="head" />
  </head>
  <body class="bg-background font-sans text-foreground antialiased">
    <header class="border-b border-line">
      <div class="mx-auto flex max-w-[1120px] flex-wrap items-center justify-between gap-x-8 gap-y-3 px-4 py-4 md:px-8">
        <a href="/" class="flex items-baseline gap-3">
          <span class="text-xl font-bold tracking-wider">NALSEC</span>
          <span class="text-xs text-muted">株式会社NALSEC</span>
        </a>
        <nav aria-label="サイト内">
          <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
            {nav.map((item) => (
              <li>
                <a href={item.href} class="hover:text-muted">
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="border-t border-line">
      <div class="mx-auto max-w-[1120px] px-4 py-8 text-sm text-muted md:px-8">
        <p>© NALSEC</p>
      </div>
    </footer>
  </body>
</html>
