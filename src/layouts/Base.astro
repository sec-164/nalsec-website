---
import "../styles/global.css";
import Logo from "../components/Logo.astro";
import { site } from "../data/site";
import { getScreens, navHref } from "../lib/screens";

interface Props {
  title: string;
  /** トップページだけ true。ヘッダーに進捗バーと見出し帯を出し、ヒーロー上では透明にする。 */
  progress?: boolean;
}

const { title, progress = false } = Astro.props;
// 画面一覧は src/lib/screens.ts が唯一の定義。トップのセクションも同じ関数から作られる。
const screens = await getScreens();
const nav = site.nav.map((item) => ({
  ...item,
  href: navHref(screens, item.id),
}));
const segments = screens.map((screen, i) => {
  const prev = screens[i - 1];
  return {
    ...screen,
    // 同じナビ内でグループ(充電器 → 電池)が変わる所は間隔を広げる
    groupBreak:
      !!prev && !!prev.group && !!screen.group && prev.group !== screen.group,
  };
});
// ヘッダー中央の見出し帯: ナビ順に「ナビ名(グループ見出し) → 属する画面の短い名前」。
// 画面が 1 つだけのナビはその画面の名前だけ(見出しを重ねない)。ヒーローは出さない。
type StripItem =
  | { kind: "group"; label: string }
  | { kind: "screen"; id: string; label: string };
const strip: StripItem[] = site.nav.flatMap((item) => {
  const own = screens.filter((s) => s.nav === item.id);
  const items: StripItem[] = own.map((s) => ({
    kind: "screen",
    id: s.id,
    label: s.short,
  }));
  return own.length > 1
    ? [{ kind: "group", label: item.label } as StripItem, ...items]
    : items;
});
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=M+PLUS+1p:wght@400;700&family=Montserrat:wght@400;700&display=swap"
    />
    <slot name="head" />
  </head>
  <body class="bg-background font-sans text-foreground antialiased">
    <!-- data-scrolled はトップページのヒーロー表示中だけ JS が "false" にする(透明・ロゴ非表示)。JS なしでは常に黒。 -->
    <header
      data-site-header
      data-scrolled="true"
      class="group/header fixed inset-x-0 top-0 z-50 border-b border-line bg-black/60 backdrop-blur transition-[background-color,backdrop-filter,border-color] duration-300 motion-reduce:transition-none data-[scrolled=false]:border-transparent data-[scrolled=false]:bg-transparent data-[scrolled=false]:backdrop-blur-none"
    >
      {/* 進捗バー(見た目はヘッダー下端。DOM 上はナビより前に置き、ヘッダー内の最初の aria-current がバーになるようにする) */}
      {progress && (
        <div class="absolute inset-x-0 bottom-0 z-10 translate-y-px">
          <ol class="mx-auto flex max-w-[1120px] items-end gap-1 px-4 md:px-8">
            {segments.map((seg) => (
              <li class:list={["flex-1", seg.groupBreak && "ml-1"]}>
                <a
                  href={`#${seg.id}`}
                  title={seg.label}
                  data-screen
                  data-nav={seg.nav ?? ""}
                  class="group/seg flex h-3 items-end focus-visible:outline-offset-1"
                >
                  <span class="sr-only">{seg.label}</span>
                  <span
                    aria-hidden="true"
                    class="relative block h-0.5 w-full overflow-hidden bg-white/25 transition-[height,background-color] duration-200 group-hover/seg:h-[3px] group-focus-visible/seg:h-[3px] group-data-[state=passed]/seg:bg-white/60 group-aria-[current=true]/seg:bg-white/40 motion-reduce:transition-none"
                  >
                    <span class="absolute inset-y-0 left-0 hidden w-[calc(var(--p,0)*100%)] bg-white group-aria-[current=true]/seg:block" />
                  </span>
                </a>
              </li>
            ))}
          </ol>
        </div>
      )}
      <div class="relative mx-auto flex h-14 max-w-[1120px] items-center justify-between gap-6 px-4 md:px-8">
        <a
          href="/"
          class="flex items-center gap-3 transition-opacity duration-300 group-data-[scrolled=false]/header:pointer-events-none group-data-[scrolled=false]/header:opacity-0 motion-reduce:transition-none"
        >
          <Logo class="h-5" />
          <span class="hidden text-xs text-muted sm:inline">
            株式会社NALSEC
          </span>
        </a>
        {progress && (
          <div
            data-strip
            class="absolute top-1/2 left-1/2 hidden w-[40%] -translate-x-1/2 -translate-y-1/2 overflow-hidden py-1.5 transition-opacity duration-300 [mask-image:linear-gradient(to_right,transparent,#000_12%,#000_88%,transparent)] group-data-[scrolled=false]/header:invisible group-data-[scrolled=false]/header:opacity-0 motion-reduce:transition-none md:block lg:w-1/2"
          >
            <div
              data-strip-row
              class="flex w-max items-baseline gap-6 whitespace-nowrap text-[13px] text-muted transition-transform duration-300 ease-in-out motion-reduce:transition-none"
            >
              {strip.map((item) =>
                item.kind === "group" ? (
                  <span class="text-[11px] tracking-[0.15em] opacity-60">
                    {item.label}
                  </span>
                ) : (
                  <a
                    href={`#${item.id}`}
                    data-strip-item={item.id}
                    class="relative transition-colors after:absolute after:inset-x-0 after:-bottom-1 after:h-px after:bg-white after:opacity-0 hover:text-foreground aria-[current=true]:text-white aria-[current=true]:after:opacity-100"
                  >
                    {item.label}
                  </a>
                ),
              )}
            </div>
          </div>
        )}
        <nav aria-label="サイト内">
          <ul class="flex gap-x-5 text-xs font-bold tracking-[0.15em] md:gap-x-8">
            {nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  data-nav-link={item.id}
                  class="relative transition-colors after:absolute after:inset-x-0 after:-bottom-1.5 after:h-px after:bg-white after:opacity-0 hover:text-muted aria-[current=true]:after:opacity-100"
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="relative z-20 border-t border-line bg-background">
      <div class="mx-auto flex max-w-[1120px] items-center justify-between gap-4 px-4 py-8 text-sm text-muted md:px-8">
        <Logo class="h-4 text-foreground" decorative />
        <p>© NALSEC</p>
      </div>
    </footer>
    {progress && <script is:inline>
      // トップページのヘッダー: 進捗バー・見出し帯・ナビのアクティブ表示・ヒーロー上の透明化。
      // 画面の一覧はセグメントのリンク(href と data-*)から読む。JS 側に一覧の写しは持たない。
      (() => {
        const header = document.querySelector("[data-site-header]");
        const segs = [...header.querySelectorAll("[data-screen]")];
        const navs = [...header.querySelectorAll("[data-nav-link]")];
        // 見出し帯: 現在の画面の項目を帯の中央に寄せる(data-index が変わった時と、寸法が変わった時に測り直す)
        const strip = header.querySelector("[data-strip]");
        const row = strip && strip.querySelector("[data-strip-row]");
        const stripItems = row
          ? new Map(
              [...row.querySelectorAll("[data-strip-item]")].map((a) => [
                a.dataset.stripItem,
                a,
              ]),
            )
          : new Map();
        const placeStrip = () => {
          if (!row || current < 0) return;
          const id = segs[current].getAttribute("href").slice(1);
          const cur = stripItems.get(id);
          stripItems.forEach((a) => {
            if (a === cur) a.setAttribute("aria-current", "true");
            else a.removeAttribute("aria-current");
          });
          if (!cur) return;
          const x =
            strip.clientWidth / 2 - (cur.offsetLeft + cur.offsetWidth / 2);
          row.style.transform = `translateX(${x.toFixed(1)}px)`;
        };
        // 移動先は各画面の直前にある高さ 0 の目印(sticky でないので offsetTop が本来の位置になる)
        const sections = segs.map((a) =>
          document.getElementById(a.getAttribute("href").slice(1)),
        );
        if (!segs.length || sections.includes(null)) return;
        let tops = [];
        let spans = [];
        let current = -1;
        const measure = () => {
          tops = sections.map((el) => el.offsetTop);
          // 各画面の長さ = 次の目印までの距離(ちょうど 1 画面分)。最後の画面は積み重ねの終わり
          // (フッターの上端。ページ末尾でスクロールが止まるならそこ)までの距離。
          const footer = document.querySelector("body > footer");
          const end = Math.min(
            footer ? footer.offsetTop : Infinity,
            document.documentElement.scrollHeight - innerHeight,
          );
          const n = tops.length;
          spans = tops.map((t, k) =>
            Math.max(1, (k + 1 < n ? tops[k + 1] : end) - t),
          );
        };
        const update = () => {
          // i = 先頭が画面上端に届いた最後の画面。p = その画面内の進み具合(0→1 で線形、次の画面の開始は 0)。
          let i = 0;
          while (i + 1 < tops.length && tops[i + 1] <= scrollY) i++;
          const p = Math.min(1, Math.max(0, (scrollY - tops[i]) / spans[i]));
          const global = (i + p) / Math.max(1, tops.length - 1);
          segs[i].style.setProperty("--p", p.toFixed(3));
          header.dataset.index = String(i);
          header.dataset.progress = p.toFixed(3);
          header.dataset.global = global.toFixed(3);
          if (i === current) return;
          current = i;
          segs.forEach((a, k) => {
            a.dataset.state =
              k < i ? "passed" : k === i ? "current" : "upcoming";
            if (k === i) a.setAttribute("aria-current", "true");
            else a.removeAttribute("aria-current");
          });
          const nav = segs[i].dataset.nav;
          navs.forEach((a) => {
            if (nav && a.dataset.navLink === nav)
              a.setAttribute("aria-current", "true");
            else a.removeAttribute("aria-current");
          });
          placeStrip();
          header.dataset.scrolled = String(i > 0);
        };
        let queued = false;
        const onScroll = () => {
          if (queued) return;
          queued = true;
          requestAnimationFrame(() => {
            queued = false;
            update();
          });
        };
        addEventListener("scroll", onScroll, { passive: true });
        addEventListener("resize", () => {
          measure();
          onScroll();
          placeStrip();
        });
        if (document.fonts) document.fonts.ready.then(placeStrip);
        addEventListener("load", () => {
          measure();
          update();
          placeStrip();
        });
        measure();
        update();
      })();
    </script>}
  </body>
</html>
