---
import "../styles/global.css";
import Logo from "../components/Logo.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
const nav = [
  { href: "/#products", label: "製品" },
  { href: "/#services", label: "サービス" },
  { href: "/#company", label: "会社情報" },
];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=M+PLUS+1p:wght@400;700&family=Montserrat:wght@400;700&display=swap"
    />
    <slot name="head" />
  </head>
  <body class="bg-background font-sans text-foreground antialiased">
    <header class="fixed inset-x-0 top-0 z-50 border-b border-line bg-black/60 backdrop-blur">
      <div class="mx-auto flex h-14 max-w-[1120px] items-center justify-between gap-6 px-4 md:px-8">
        <a href="/" class="flex items-center gap-3">
          <Logo class="h-5" />
          <span class="hidden text-xs text-muted sm:inline">
            株式会社NALSEC
          </span>
        </a>
        <nav aria-label="サイト内">
          <ul class="flex gap-x-5 text-xs font-bold tracking-[0.15em] md:gap-x-8">
            {nav.map((item) => (
              <li>
                <a href={item.href} class="transition-colors hover:text-muted">
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="relative z-20 border-t border-line bg-background">
      <div class="mx-auto flex max-w-[1120px] items-center justify-between gap-4 px-4 py-8 text-sm text-muted md:px-8">
        <Logo class="h-4 text-foreground" decorative />
        <p>© NALSEC</p>
      </div>
    </footer>
  </body>
</html>
