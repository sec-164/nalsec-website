---
import { site } from "../data/site";

const container = "mx-auto max-w-[1120px] px-4 md:px-8";
---

<section class="border-t border-line bg-surface">
  <div
    class={`${container} flex flex-col gap-4 py-12 md:flex-row md:items-center md:justify-between`}
  >
    <h2 class="text-sm font-bold tracking-wider">技術マガジン</h2>
    <p>
      <a
        href={site.techSiteUrl}
        class="underline underline-offset-4 hover:text-muted"
      >
        {site.techSiteLabel} →
      </a>
    </p>
  </div>
</section>
