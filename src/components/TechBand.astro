---
import { site } from "../data/site";

const { embedded = false } = Astro.props;
const Tag = embedded ? "div" : "section";
const container = "mx-auto max-w-[1120px] px-4 md:px-8";
---

<Tag
  class={
    embedded
      ? "mt-8 border-t border-line md:mt-12"
      : "border-t border-line bg-surface"
  }
>
  <div
    class={`${embedded ? "" : container} flex flex-col ${embedded ? "gap-2" : "gap-4"} md:flex-row md:items-center md:justify-between ${embedded ? "pt-4 md:pt-6" : "py-12"}`}
  >
    <h2 class="text-sm font-bold tracking-wider">技術マガジン</h2>
    <p>
      <a
        href={site.techSiteUrl}
        class="underline underline-offset-4 hover:text-muted"
      >
        {site.techSiteLabel} →
      </a>
    </p>
  </div>
</Tag>
