---
import { site } from "../data/site";
import { heroBackground } from "../data/backgrounds";
import Logo from "./Logo.astro";
import PhotoBackground from "./PhotoBackground.astro";

const taglineLines = site.tagline.split("\n");
---

<section class="sticky top-0 z-[1] flex h-svh items-center overflow-hidden pt-14">
  <PhotoBackground bg={heroBackground} eager />
  <div class="container-x relative w-full py-12 md:py-16">
    <div class="hero-in">
      <h1>
        <Logo class="h-14 md:h-20" decorative />
        <span class="sr-only">{site.name}</span>
      </h1>
      <div class="mt-6 w-24 border-t-2 border-foreground md:mt-8"></div>
      <p class="mt-8 text-lg leading-loose md:text-xl">
        {taglineLines.map((line, i) => (
          <>
            {i > 0 && <br />}
            {line}
          </>
        ))}
      </p>
    </div>
  </div>
  <div
    class="absolute bottom-6 left-1/2 flex -translate-x-1/2 flex-col items-center gap-2"
    aria-hidden="true"
  >
    <span class="text-[10px] tracking-[0.3em] text-muted">SCROLL</span>
    <span class="h-10 w-px bg-white/60"></span>
  </div>
</section>
