---
import { site } from "../data/site";
import Logo from "./Logo.astro";

const label = site.nav.find((n) => n.id === "company")?.label;
---

<div>
  <div>
    <h2 class="text-4xl font-bold lg:text-5xl">{label}</h2>
    <div class="mt-6 w-24 border-t-2 border-foreground"></div>
    <div class="mt-6 grid gap-5 md:mt-12 md:grid-cols-2 md:gap-12">
      <dl class="space-y-3 leading-relaxed md:space-y-6 md:leading-loose">
        <div>
          <dt class="text-sm text-muted">会社名</dt>
          <dd class="flex items-center gap-3">
            <Logo class="h-3.5" decorative />
            {site.name}
          </dd>
        </div>
        <div>
          <dt class="text-sm text-muted">所在地</dt>
          <dd>
            {site.address.postalCode}
            <br />
            {site.address.text}
          </dd>
        </div>
        <div>
          <dt class="text-sm text-muted">電話</dt>
          <dd>{site.phone}</dd>
        </div>
      </dl>
      <div>
        <h3 class="text-sm text-muted">事業内容</h3>
        <ul class="mt-2 border-t border-line">
          {site.businessLines.map((line) => (
            <li class="border-b border-line py-2 md:py-4">{line}</li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</div>
