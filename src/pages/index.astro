---
// 全画面セクションを sticky で重ねる構成(ヒーロー → 製品シリーズ → サービス → 会社情報)。
// 画面の並びと id は src/lib/screens.ts の getScreens() が唯一の定義。右端のセクションナビ(SectionNav)も同じ一覧から作る。
// 製品は series コレクション単位で 1 画面。兄弟製品は同じ画面に並べ、highlights で違いだけを示す。
// 背景は現行サイトの写真を暫定流用(src/data/backgrounds.ts)。セクションの動きは CSS(スクロール連動)のみ。ヘッダーの透明化とセクションナビの現在地は SectionNav の小さなインラインスクリプトが担う。
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import CompanyInfo from "../components/CompanyInfo.astro";
import PhotoBackground from "../components/PhotoBackground.astro";
import {
  heroBackground,
  serviceBackground,
  seriesBackground,
} from "../data/backgrounds";
import { getCollection, getEntry } from "astro:content";
import { getScreens } from "../lib/screens";

const seriesList = (await getCollection("series")).sort(
  (a, b) => a.data.order - b.data.order,
);
const series = await Promise.all(
  seriesList.map(async (s) => ({
    ...s.data,
    id: s.id,
    bg: seriesBackground(s.id),
    products: await Promise.all(
      s.data.products.map(async (id) => {
        const p = await getEntry("products", id);
        if (!p) throw new Error(`series ${s.id}: product "${id}" not found`);
        return {
          title: p.data.title,
          highlights: p.data.highlights ?? [],
          href: `/products/${p.id}/`,
        };
      }),
    ),
  })),
);
const services = await getCollection("services");
const screens = await getScreens();
const seriesById = new Map(series.map((s) => [s.id, s]));
const serviceById = new Map(services.map((s) => [s.id, s]));
for (const screen of screens) {
  const known =
    screen.id === "hero" ||
    screen.id === "company" ||
    seriesById.has(screen.id) ||
    serviceById.has(screen.id);
  if (!known) throw new Error(`screen "${screen.id}": 描画する内容がない`);
}

// pt-14 は固定ヘッダーの高さ。本文はその下の残りで縦中央に置く。
const sectionClass =
  "sticky top-0 flex h-svh items-center overflow-hidden border-t border-line bg-background pt-14";
// 製品・サービスの項目は全体を 1 枚のリンクパネル(global.css の .panel)にし、中に擬似ボタン(非インタラクティブな .btn-pill)を置く。
// パネルの group は、パネルの hover・focus で丸ボタンを塗りつぶすため。
---

<Base title="株式会社NALSEC" home>
  {screens.map((screen, i) => {
    const s = seriesById.get(screen.id);
    const item = serviceById.get(screen.id);
    return (
      <>
        {/* 移動先の目印(id = 画面 id)。sticky のセクション自体を移動先にすると、貼り付いている間は
            上へ戻るアンカー移動が効かないので、流れの中に高さ 0 の要素を置く。 */}
        <div id={screen.id} aria-hidden="true"></div>
        {screen.id === "hero" && <Hero />}

        {s && (
          <section class={sectionClass} style={`z-index:${i + 1}`}>
            <PhotoBackground bg={s.bg} />
            {/* スマホは下を厚くして中身を上へ寄せ、右下の固定バナー(TechBanner)と最後の「詳細を見る」が重ならないようにする */}
            <div class="container-x nav-clear reveal relative w-full pt-0 pb-10 md:py-12">
              <p class="eyebrow">
                <span class="eyebrow-line" aria-hidden="true"></span>
                {s.categoryLabel}
              </p>
              <h2 class="mt-2 text-display leading-tight font-bold md:mt-4 md:leading-snug lg:text-display-lg">
                {s.title}
              </h2>
              <p class="mt-2 leading-normal text-muted md:mt-4 md:leading-relaxed">
                {s.lead}
              </p>

              {s.products.length === 2 && (
                <div class="mt-4 grid items-stretch gap-0 divide-y divide-line overflow-hidden rounded-panel border border-line md:mt-12 md:grid-cols-2 md:divide-x md:divide-y-0">
                  {s.products.map((p) => (
                    <a
                      href={p.href}
                      class="panel group grid grid-rows-[auto_auto_1fr] content-start md:row-span-3 md:grid-rows-subgrid"
                    >
                      <h3 class="text-title-sm leading-snug font-bold md:text-title">
                        {p.title}
                      </h3>
                      <p class="mt-1 leading-snug md:mt-4 md:leading-loose">
                        {p.highlights.map((line, k) => (
                          <>
                            {k > 0 && <br />}
                            {line}
                          </>
                        ))}
                      </p>
                      <span class="btn-pill mt-2 justify-self-start md:mt-4 md:self-end">
                        詳細を見る →
                      </span>
                    </a>
                  ))}
                </div>
              )}

              {/* 3 製品以上の一覧は、SP(md 未満)では 1 画面に収めるため説明を 16px(text-label)・製品名を 18px にし、余白も詰める */}
              {s.products.length >= 3 && (
                <div class="mt-4 flex flex-col gap-0 divide-y divide-line overflow-hidden rounded-panel border border-line md:mt-12">
                  {s.products.map((p) => (
                    <a
                      href={p.href}
                      class="panel group grid grid-cols-[minmax(0,1fr)_auto] items-end gap-x-2 px-2.5 py-2 md:grid-cols-[minmax(0,3fr)_minmax(0,2fr)_auto] md:items-center md:gap-x-10 md:px-8 md:py-6"
                    >
                      <h3 class="col-span-2 text-body leading-snug font-bold md:col-span-1 md:text-title">
                        {p.title}
                      </h3>
                      <p class="mt-1 text-label leading-snug md:mt-0 md:text-body md:leading-loose">
                        {p.highlights.map((line, k) => (
                          <>
                            {k > 0 && <br />}
                            {line}
                          </>
                        ))}
                      </p>
                      <span class="btn-pill self-end max-md:px-3 max-md:py-1 md:self-auto">
                        詳細を見る →
                      </span>
                    </a>
                  ))}
                </div>
              )}

              {s.products.length === 1 && (
                <div class="mt-6 grid items-stretch gap-0 md:mt-12 md:grid-cols-2">
                  {s.products.map((p) => (
                    <a
                      href={p.href}
                      class="panel group flex flex-col rounded-panel border border-line"
                    >
                      <h3 class="text-title-sm leading-snug font-bold md:text-title">
                        {p.title}
                      </h3>
                      <p class="mt-1 leading-snug md:mt-4 md:leading-loose">
                        {p.highlights.map((line, k) => (
                          <>
                            {k > 0 && <br />}
                            {line}
                          </>
                        ))}
                      </p>
                      <span class="btn-pill mt-2 self-start md:mt-auto">
                        詳細を見る →
                      </span>
                    </a>
                  ))}
                </div>
              )}
            </div>
          </section>
        )}

        {item && (
          <section class={sectionClass} style={`z-index:${i + 1}`}>
            <PhotoBackground bg={serviceBackground} />
            <div class="container-x nav-clear reveal relative w-full py-12 md:py-16">
              <div class="max-w-lead">
                <p class="eyebrow">
                  <span class="eyebrow-line" aria-hidden="true"></span>
                  サービス
                </p>
                <a
                  href={`/services/${item.id}/`}
                  class="panel group mt-4 flex flex-col rounded-panel border border-line"
                >
                  <h2 class="text-display leading-snug font-bold lg:text-display-lg">
                    {item.data.title}
                  </h2>
                  <p class="mt-6 leading-loose">
                    {item.data.summary
                      .trim()
                      .split("\n")
                      .map((line, j) => (
                        <>
                          {j > 0 && <br />}
                          {line}
                        </>
                      ))}
                  </p>
                  <span class="btn-pill mt-6 self-start">詳細を見る →</span>
                </a>
              </div>
            </div>
          </section>
        )}

        {screen.id === "company" && (
          <section class={sectionClass} style={`z-index:${i + 1}`}>
            <PhotoBackground bg={heroBackground} heavy />
            <div class="container-x nav-clear reveal relative w-full py-8">
              <CompanyInfo />
            </div>
          </section>
        )}
      </>
    );
  })}
</Base>
