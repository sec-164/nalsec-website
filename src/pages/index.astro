---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";
import { site } from "../data/site";

const products = (await getCollection("products")).sort(
  (a, b) => a.data.order - b.data.order,
);
const categoryLabels = ["充電器", "電池"];
const services = (await getCollection("services")).sort(
  (a, b) => a.data.order - b.data.order,
);
const taglineLines = site.tagline.split("\n");
---

<Base title={site.name}>
  <h1>{site.name}</h1>
  <p>
    {taglineLines.map((line, i) => (
      <>
        {i > 0 && <br />}
        {line}
      </>
    ))}
  </p>

  <h2>製品</h2>
  {categoryLabels.map((label) => (
    <section>
      <h3>{label}</h3>
      {products
        .filter((p) => p.data.categoryLabel === label)
        .map((p) => (
          <section>
            <h4>
              <a href={`/products/${p.id}/`}>{p.data.title}</a>
            </h4>
            <p>
              {p.data.summary
                .trim()
                .split("\n")
                .map((line, i) => (
                  <>
                    {i > 0 && <br />}
                    {line}
                  </>
                ))}
            </p>
          </section>
        ))}
    </section>
  ))}

  <h2>サービス</h2>
  {services.map((s) => (
    <section>
      <h3>
        <a href={`/services/${s.id}/`}>{s.data.title}</a>
      </h3>
      <p>
        {s.data.summary
          .trim()
          .split("\n")
          .map((line, i) => (
            <>
              {i > 0 && <br />}
              {line}
            </>
          ))}
      </p>
    </section>
  ))}

  <h2>会社情報</h2>
  <p>
    {site.address.postalCode} {site.address.text}
  </p>
  <p>電話: {site.phone}</p>
  <ul>
    {site.businessLines.map((line) => (
      <li>{line}</li>
    ))}
  </ul>

  <h2>技術マガジン</h2>
  <p>
    <a href={site.techSiteUrl}>{site.techSiteLabel}</a>
  </p>
</Base>
