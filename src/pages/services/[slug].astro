---
import Base from "../../layouts/Base.astro";
import PageBand from "../../components/PageBand.astro";
import { serviceBackground } from "../../data/backgrounds";
import { getCollection } from "astro:content";
import { wrapTables } from "../../lib/wrap-tables";

export async function getStaticPaths() {
  const entries = await getCollection("services");
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const d = entry.data;
const html = wrapTables(entry.rendered?.html ?? "");
---

<Base title={`${d.title} | 株式会社NALSEC`}>
  <PageBand
    bg={serviceBackground}
    label="サービス"
    title={d.title}
    summary={d.summary}
  />
  <section class="surface-light py-14 md:py-20">
    <div class="container-x">
      <div class="mx-auto max-w-column">
        <p class="mb-10 text-label">
          <a href="/" class="back-link">
            ← トップへ戻る
          </a>
        </p>
        <article class="content">
          <Fragment set:html={html} />
        </article>
        <p class="mt-14 border-t border-rule pt-8 text-label">
          <a href="/" class="back-link">
            ← トップへ戻る
          </a>
        </p>
      </div>
    </div>
  </section>
</Base>
