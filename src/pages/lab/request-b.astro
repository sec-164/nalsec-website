---
// 資料請求フォームの試作 B(ステップ型)の確認用ページ。製品ページ(products/[slug].astro)の下部を模す。
import Base from "../../layouts/Base.astro";
import PageBand from "../../components/PageBand.astro";
import RequestFormB from "../../components/lab/RequestFormB.astro";
import { seriesBackground } from "../../data/backgrounds";
import { getCollection, getEntry } from "astro:content";

const entry = await getEntry("products", "xnergy-be");
if (!entry) throw new Error("products/xnergy-be が見つかりません");
const d = entry.data;
const series = (await getCollection("series")).find((s) =>
  s.data.products.includes(entry.id),
);
const bg = seriesBackground(series?.id ?? "");
---

<Base title={`試作 B: 資料請求(ステップ型) | 株式会社NALSEC`}>
  <PageBand
    bg={bg}
    label={d.categoryLabel}
    title={d.title}
    summary={d.summary}
  />
  <section class="bg-white py-14 text-neutral-900 md:py-20">
    <div class="container-x">
      <div class="mx-auto max-w-[46rem]">
        <article class="content">
          <p>
            (本文のスタブ)製品ページでは、ここに製品の特長・仕様・用途が入ります。
          </p>
          <p>
            このページは資料請求フォームの試作
            B(ステップ型)を確認するためのものです。
          </p>
        </article>
      </div>
    </div>
  </section>
  <RequestFormB current={entry.id} />
</Base>
