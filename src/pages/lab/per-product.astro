---
// レイアウト試作 3: 製品ごとに 1 画面(100svh)+ sticky で次の項目が前の項目を覆う。
// 画像・動きなし(背景は面の色だけのプレースホルダー)、JS なし。
import Base from "../../layouts/Base.astro";
import Hero from "../../components/Hero.astro";
import CompanyInfo from "../../components/CompanyInfo.astro";
import TechBand from "../../components/TechBand.astro";
import { getCollection } from "astro:content";

const products = (await getCollection("products")).sort(
  (a, b) => a.data.order - b.data.order,
);
const categoryLabels = ["充電器", "電池"];
const services = (await getCollection("services")).sort(
  (a, b) => a.data.order - b.data.order,
);

// トップページと同じ並び(カテゴリ順 → order 順)。
const items = [
  ...categoryLabels.flatMap((label) =>
    products
      .filter((p) => p.data.categoryLabel === label)
      .map((p) => ({
        label,
        title: p.data.title,
        summary: p.data.summary,
        href: `/products/${p.id}/`,
      })),
  ),
  ...services.map((s) => ({
    label: "サービス",
    title: s.data.title,
    summary: s.data.summary,
    href: `/services/${s.id}/`,
  })),
];
const container = "mx-auto max-w-[1120px] px-4 md:px-8";
---

<Base title="試作 3: 製品ごと 100vh | 株式会社NALSEC">
  <meta slot="head" name="robots" content="noindex, nofollow" />

  <p class="border-b border-line">
    <span class={`${container} block py-2 text-xs text-muted`}>
      レイアウト試作 3 — 製品ごとに 1 画面(100vh)+ sticky。画像・動きなし。
      <a href="/" class="underline underline-offset-4 hover:text-foreground">
        現在のトップへ
      </a>
    </span>
  </p>

  <Hero stacked />

  <div id="products">
    {items.map((item, i) => (
      <section
        class="sticky top-0 flex h-svh items-center overflow-hidden border-t border-line bg-background"
        style={`z-index:${i + 2}`}
        id={i === products.length ? "services" : undefined}
      >
        <div
          class={`absolute inset-0 ${i % 2 === 0 ? "bg-surface" : "bg-white/10"}`}
          aria-hidden="true"
        />
        <div class={`${container} relative w-full py-16`}>
          <div class="max-w-3xl">
            <p class="text-sm text-muted">{item.label}</p>
            <h2 class="mt-4 text-4xl leading-snug font-bold lg:text-5xl">
              {item.title}
            </h2>
            <p class="mt-8 text-lg leading-loose">
              {item.summary
                .trim()
                .split("\n")
                .map((line, j) => (
                  <>
                    {j > 0 && <br />}
                    {line}
                  </>
                ))}
            </p>
            <p class="mt-8">
              <a
                href={item.href}
                class="underline underline-offset-4 hover:text-muted"
                aria-label={`${item.title}の詳細を見る`}
              >
                詳細を見る →
              </a>
            </p>
          </div>
        </div>
      </section>
    ))}
  </div>

  <section
    class="sticky top-0 flex h-svh items-center overflow-hidden border-t border-line bg-background"
    style={`z-index:${items.length + 2}`}
  >
    <div class="absolute inset-0 bg-surface" aria-hidden="true"></div>
    <div class={`${container} relative w-full`}>
      <CompanyInfo embedded />
      <TechBand embedded />
    </div>
  </section>
</Base>
