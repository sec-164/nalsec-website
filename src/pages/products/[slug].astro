---
import Base from "../../layouts/Base.astro";
import PageBand from "../../components/PageBand.astro";
import { seriesBackground } from "../../data/backgrounds";
import { getCollection } from "astro:content";
import { wrapTables } from "../../lib/wrap-tables";

export async function getStaticPaths() {
  const entries = await getCollection("products");
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const d = entry.data;
const html = wrapTables(entry.rendered?.html ?? "");
const series = (await getCollection("series")).find((s) =>
  s.data.products.includes(entry.id),
);
const bg = seriesBackground(series?.id ?? "");
---

<Base title={`${d.title} | 株式会社NALSEC`}>
  <PageBand
    bg={bg}
    label={d.categoryLabel}
    title={d.title}
    summary={d.summary}
  />
  <section class="bg-white py-14 text-neutral-900 md:py-20">
    <div class="container-x">
      <div class="mx-auto max-w-[46rem]">
        <p class="mb-10 text-sm">
          <a
            href="/"
            class="text-neutral-600 underline-offset-4 transition-colors hover:text-black hover:underline"
          >
            ← トップへ戻る
          </a>
        </p>
        <article class="content">
          <Fragment set:html={html} />
        </article>
        <p class="mt-14 border-t border-neutral-200 pt-8 text-sm">
          <a
            href="/"
            class="text-neutral-600 underline-offset-4 transition-colors hover:text-black hover:underline"
          >
            ← トップへ戻る
          </a>
        </p>
      </div>
    </div>
  </section>
</Base>
