---
import Base from "../../layouts/Base.astro";
import PageBand from "../../components/PageBand.astro";
import { seriesBackground } from "../../data/backgrounds";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const entries = await getCollection("products");
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const series = (await getCollection("series")).find((s) =>
  s.data.products.includes(entry.id),
);
const bg = seriesBackground(series?.id ?? "");
---

<Base title={`${d.title} | 株式会社NALSEC`}>
  <PageBand
    bg={bg}
    label={d.categoryLabel}
    title={d.title}
    summary={d.summary}
  />
  <article class="mx-auto max-w-[1120px] px-4 py-12 md:px-8 md:py-20">
    <div class="content max-w-3xl">
      <Content />
    </div>

    <p class="mt-16 border-t border-line pt-8">
      <a
        href="/"
        class="inline-block rounded-full border border-white/40 px-4 py-1.5 text-sm transition-colors hover:bg-white hover:text-black"
      >
        ← トップへ戻る
      </a>
    </p>
  </article>
</Base>
