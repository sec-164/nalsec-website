---
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const entries = await getCollection("products");
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
---

<Base title={`${d.title} | 株式会社NALSEC`}>
  <article class="mx-auto max-w-[1120px] px-4 py-16 md:px-8 md:py-24">
    <h1 class="text-3xl leading-tight font-bold md:text-5xl">{d.title}</h1>
    <div class="mt-6 w-24 border-t-2 border-foreground"></div>
    <p class="mt-8 leading-loose text-muted">
      {d.summary
        .trim()
        .split("\n")
        .map((line, i) => (
          <>
            {i > 0 && <br />}
            {line}
          </>
        ))}
    </p>
    <div class="content mt-16 max-w-3xl">
      <Content />
    </div>

    <p class="mt-16 border-t border-line pt-8 text-sm">
      <a href="/" class="hover:text-muted">
        ← トップへ戻る
      </a>
    </p>
  </article>
</Base>
