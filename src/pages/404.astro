---
import Base from "../layouts/Base.astro";
import PhotoBackground from "../components/PhotoBackground.astro";
import { heroBackground } from "../data/backgrounds";
---

<Base title="ページが見つかりません | 株式会社NALSEC">
  <section class="relative flex min-h-svh items-center justify-center overflow-hidden px-4 pt-14 text-center">
    <PhotoBackground bg={heroBackground} eager heavy />
    <div class="hero-in relative py-24">
      <p class="text-5xl font-bold tracking-wide lg:text-6xl">404</p>
      <div class="mx-auto mt-6 w-24 border-t-2 border-foreground"></div>
      <h1 class="mt-6 text-xl font-bold">ページが見つかりません</h1>
      <p class="mt-8">
        <a
          href="/"
          class="inline-block rounded-full border border-white/40 px-4 py-1.5 text-sm transition-colors hover:bg-white hover:text-black"
        >
          トップへ戻る
        </a>
      </p>
    </div>
  </section>
</Base>
